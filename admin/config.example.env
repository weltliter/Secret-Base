# Copy to config.env, or run: .\console.ps1 -Action Configure
# KEY=VALUE only; values are literal, with optional matching quotes.
VAULT_SSH_HOST=your-ecs.example.com
VAULT_SSH_USER=root
VAULT_SSH_PORT=22
VAULT_SSH_KEY_FILE=".local/keys/your-ecs-key.pem"
VAULT_LOCAL_PORT=18080
VAULT_REMOTE_PORT=18080
