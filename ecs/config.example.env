# Copy to config.env. This is the only editable ECS environment configuration.
# KEY=VALUE only; optional matching quotes, no variable/command interpolation.
VAULT_PROJECT_NAME=wechat-vault
VAULT_STATE_DIR=/var/lib/wechat-vault
VAULT_ADMIN_PORT=18080
VAULT_APP_IMAGE=wechat-vault-app:local
POSTGRES_IMAGE=postgres:17-alpine
PYTHON_BASE=python:3.12-slim-trixie
PIP_INDEX_URL=https://pypi.org/simple
VAULT_MODEL_SOURCE=huggingface.co
VAULT_BACKUP_TIMEOUT_SECONDS=1800
VAULT_BACKUP_RETENTION_DAYS=7
VAULT_BACKUP_QUOTA_BYTES=5368709120
VAULT_BACKUP_RESERVE_BYTES=1073741824
VAULT_DOWNLOAD_TIMEOUT_SECONDS=1800
VAULT_DOWNLOAD_CONCURRENCY=2
